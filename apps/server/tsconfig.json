{
  "extends": "@sutra/config/tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "include": [
    "src/**/*",
    "drizzle.config.ts",
    "../../packages/shared/src/create-app.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
