{
  "name": "sutra",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/bun": "^1.3.14",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.7",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:push": "turbo run db:push -F @sutra/db",
    "db:studio": "turbo run db:studio -F @sutra/db",
    "db:generate": "turbo run db:generate -F @sutra/db",
    "db:migrate": "turbo run db:migrate -F @sutra/db",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@scalar/hono-api-reference": "^0.11.13",
    "@sutra/env": "workspace:*",
    "@sutra/shared": "workspace:*",
    "dotenv": "catalog:",
    "hono-rate-limiter": "^0.5.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sutra/config": "workspace:*",
    "@types/bun": "catalog:",
    "prettier": "^3.7.4",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.2.22"
}
